# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-teranode-p2p-client
# Load Order: 90 (project layer, loaded last to override all defaults)
#
# This file contains project-specific configuration that overrides defaults from
# lower-numbered env files. Settings here are unique to this repository.
#
# ================================================================================================

# ================================================================================================
# 🔧 GO VERSION CONFIGURATION
# ================================================================================================

# Custom Go Version per go.mod
GO_PRIMARY_VERSION=1.25.x
GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_VERSION=1.25.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Provider (overrides 10-coverage.env default of "internal")
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusion paths (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/

# ================================================================================================
# 🛡️ VULNERABILITY SCANNING EXCLUSIONS
# ================================================================================================

# Custom exclusions for AskNancy vulnerability scanning
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-24051,CVE-2026-26014,CVE-2026-26958
MAGE_X_CVE_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-64702,CVE-2021-43668,CVE-2023-26248,CVE-2026-24051,CVE-2026-26014,CVE-2026-26958

# CVE-2025-64702 for quic-go@v0.55.0
#
# This is in regards to:
# Vulnerability #1: GO-2024-3218
#    Content Censorship in the InterPlanetary File System (IPFS) via Kademlia DHT
#    abuse in github.com/libp2p/go-libp2p-kad-dht
#  More info: https://pkg.go.dev/vuln/GO-2024-3218
#  Module: github.com/libp2p/go-libp2p-kad-dht
#    Found in: github.com/libp2p/go-libp2p-kad-dht@v0.35.1

# CVE-2026-24051 for go.opentelemetry.io/otel/sdk@v1.39.0
#
# This is in regards to:
# Vulnerability: CVE-2026-24051
#    Security vulnerability in OpenTelemetry SDK
#    in go.opentelemetry.io/otel/sdk
#  More info: https://ossindex.sonatype.org/vulnerability/CVE-2026-24051
#  Module: go.opentelemetry.io/otel/sdk
#    Found in: go.opentelemetry.io/otel/sdk@v1.39.0

# CVE-2026-26958 for filippo.io/edwards25519@v1.1.0
# Improper Initialization (CWE-665) - MultiScalarMult returns incorrect results if receiver
# is not the identity point. Rarely-used advanced API; does not affect users via go-sql-driver/mysql.
# Fixed in: filippo.io/edwards25519@v1.1.1 (transitive dependency; no direct upgrade path)
# CVSS Score: 1.7/10 (Low) - Monitoring: track upstream for removal of v1.1.0 transitive dep

# CVE-2026-26014 for github.com/pion/dtls/v2@v2.2.12
# Information Exposure (CWE-200) - Random nonce generation with GCM ciphers
# Affects: pion/dtls/v2 v1.0.0 through v2.2.12 (v2.2.12 is latest in v2 branch)
# Fixed in: pion/dtls/v3@v3.1.0+ (we have v3.1.1, which is safe)
# Dependency path: go-teranode-p2p-client → go-libp2p@v0.47.0 → pion/webrtc/v4 → pion/dtls/v2
# Status: Transitive dependency - cannot upgrade v2→v3 (different major versions)
# Mitigation: v3.1.1 is already present for WebRTC functionality
# Risk: Low - vulnerability in legacy v2 branch, safe v3 branch in use
# Monitoring: Track go-libp2p releases for removal of v2 dependency

# ================================================================================================
# 🧪 TESTING CONFIGURATION
# ================================================================================================

# Increase fuzz test timeout to allow for cold-cache compilation
# FuzzBlockMessageUnmarshal (first alphabetically) must compile the test binary
# from scratch in fuzz mode, which with the heavy dependency tree can exceed the
# default per-test budget derived from TEST_TIMEOUT_FUZZ=5m.
TEST_TIMEOUT_FUZZ=15m
